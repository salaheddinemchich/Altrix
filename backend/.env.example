# ══════════════════════════════════════════════════════════════════════════════
# Altrix — Environment Variables Reference
#
# Copy this file to .env and fill in the values for your environment.
# .env is loaded by Docker Compose.  Spring services pick up variables from
# the process environment — inject them via .env (local), EC2 User Data
# (staging/prod), or AWS Secrets Manager / Parameter Store (prod).
#
# SPRING_PROFILES_ACTIVE controls which application-{profile}.yml is loaded:
#   dev      → local Docker Compose (default if unset)
#   staging  → AWS EC2 pre-production
#   prod     → AWS EC2 / ECS production
# ══════════════════════════════════════════════════════════════════════════════

# ── Active Spring profile ──────────────────────────────────────────────────────
# Uncomment and set for staging/prod deployments.
# SPRING_PROFILES_ACTIVE=dev

# ─── Database (PostgreSQL 16) ──────────────────────────────────────────────────
# Local dev: matches the Docker Compose postgres service credentials.
# Staging/prod: point to your RDS endpoint.
POSTGRES_USER=altrix
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=altrix_db

# Staging / prod only — not used by Docker Compose (which binds on localhost).
# POSTGRES_HOST=your-rds-endpoint.rds.amazonaws.com
# POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_in_prod

# Staging / prod only.
# REDIS_HOST=your-elasticache-endpoint.cache.amazonaws.com
# REDIS_PORT=6379

# Lettuce connection pool (override defaults per environment)
# REDIS_POOL_MAX_ACTIVE=16
# REDIS_POOL_MAX_IDLE=8
# REDIS_POOL_MIN_IDLE=2
# REDIS_POOL_MAX_WAIT=2000ms

# ─── MinIO (local object storage) ────────────────────────────────────────────
# Staging/prod: replace with S3 bucket settings and disable MinIO container.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_in_prod

# MINIO_ENDPOINT=http://localhost:9000    # local dev default
# MINIO_ENDPOINT=https://s3.amazonaws.com  # AWS S3 (staging/prod)

# ─── Kafka ────────────────────────────────────────────────────────────────────
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092          # local Docker Compose
# KAFKA_BOOTSTRAP_SERVERS=your-broker:9092         # staging/prod MSK

# ─── PgAdmin UI (local only) ──────────────────────────────────────────────────
PGADMIN_PASSWORD=admin

# ─── Provider Config Encryption (platform-orchestrator) ───────────────────────
# AES-256-GCM key used to encrypt AI provider API keys stored in the DB.
# Generate with: openssl rand -base64 32
# Required if users save custom API keys via PUT /api/ai/providers/{id}.
PROVIDER_CONFIG_ENCRYPTION_KEY=

# ─── AI Providers ─────────────────────────────────────────────────────────────
# At minimum one provider must be enabled.  Groq free-tier works without a key
# change for basic testing; other providers require paid API keys.

# Groq (free tier — default enabled)
AI_PROVIDER_API_KEY=your_groq_api_key_here
AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=                          # explicit override (same as above)

# OpenAI (paid — disabled by default)
# OPENAI_ENABLED=true
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_ANALYSIS=gpt-4o-mini
# OPENAI_MODEL_MIGRATION=gpt-4o

# Anthropic (paid — disabled by default)
# ANTHROPIC_ENABLED=true
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_ANALYSIS=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_MIGRATION=claude-sonnet-4-6

# DeepSeek (disabled by default)
# DEEPSEEK_ENABLED=true
# DEEPSEEK_API_KEY=

# Ollama (local — disabled by default)
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434

# ─── AI Routing ───────────────────────────────────────────────────────────────
# AI_ROUTING_STRATEGY=TIER_PREFERENCE      # TIER_PREFERENCE | EXPLICIT_ORDER
# AI_ROUTING_TIER_PREFERENCE=FREE_FIRST    # FREE_FIRST | PAID_FIRST (default: PAID_FIRST)
# AI_INTER_AGENT_DELAY_MS=2000             # ms between agents (rate-limit guard)

# ─── RAG / Embedding ──────────────────────────────────────────────────────────
# RAG_EMBEDDING_PROVIDER=openai            # openai (default) | ollama
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_EMBEDDING_MODEL_OLLAMA=nomic-embed-text

# ─── MCP (agentic tool calls — optional) ─────────────────────────────────────
# AI_MCP_ENABLED=false
# AI_MCP_MAX_TOOL_ITERATIONS=5

# ─── SonarQube (local only) ───────────────────────────────────────────────────
SONAR_JDBC_PASSWORD=sonar_pass
SONAR_TOKEN=
SONAR_HOST_URL=http://localhost:9003

# ─── DefectDojo (local only) ──────────────────────────────────────────────────
DD_DB_PASSWORD=change_me
DD_SECRET_KEY=change_me_50chars_minimum_here_for_django
DD_AES_256_KEY=change_me_32chars_exactly_here__
DD_ADMIN_PASSWORD=admin

# ─── CORS ─────────────────────────────────────────────────────────────────────
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Prod: set to your actual frontend domain, e.g. https://app.altrix.io

# ─── CI/CD (GitHub Actions secrets — not stored here, documented for reference)
# GITHUB_TOKEN             auto-injected by Actions
# GITLEAKS_LICENSE         optional Gitleaks Enterprise license
# GHCR_USERNAME            GitHub username for GHCR push
# STAGING_HOST             EC2 public IP or hostname for SSH deploy
# STAGING_SSH_KEY          private key for EC2 deploy user (base64 or PEM)
# STAGING_ENABLED          set to 'true' to trigger staging deploy step
# DEFECTDOJO_URL           optional DefectDojo API endpoint for scan upload
# DEFECTDOJO_API_KEY       DefectDojo API key
