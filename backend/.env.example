# ─── Database ──────────────────────────────────────────────────
POSTGRES_USER=migrator
POSTGRES_PASSWORD=change_me
POSTGRES_DB=migrator_db

# ─── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=change_me

# ─── MinIO ─────────────────────────────────────────────────────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me

# ─── PgAdmin UI ────────────────────────────────────────────────
PGADMIN_PASSWORD=change_me

# ─── SonarQube DB (used by both sonarqube-db and sonarqube) ───
SONAR_JDBC_PASSWORD=change_me

# ─── AI Provider (Groq — free tier) ────────────────────────────
AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER_API_KEY=your_groq_api_key_here
AI_PROVIDER_MODEL=llama-3.3-70b-versatile

# ─── SonarQube (local analysis) ────────────────────────────────
# After docker compose up, go to http://localhost:9003
# Login admin/admin → change password → create project → get token
SONAR_TOKEN=your_sonarqube_token_here
SONAR_HOST_URL=http://localhost:9003

# ─── WebSocket CORS (production) ───────────────────────────────
# Comma-separated list of allowed frontend origins
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ─── DefectDojo (optional — enables CI findings aggregation) ───
# Set these as GitHub repository variables/secrets if you run DefectDojo
# DEFECTDOJO_URL=https://your-defectdojo-instance.com
# DEFECTDOJO_API_KEY=your_api_key_here
